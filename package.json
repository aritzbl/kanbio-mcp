{
  "name": "kanbio-mcp",
  "version": "0.1.0",
  "description": "MCP server for Kanbio: read, comment, create and move tickets from Claude, Cursor or any MCP client.",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "kanbio-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "inspect": "npx @modelcontextprotocol/inspector@0.21.2 node dist/index.js"
  },
  "keywords": [
    "mcp",
    "kanbio",
    "model-context-protocol",
    "claude",
    "cursor"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
